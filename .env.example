# Copy this file to .env and fill in real values. Never commit .env to GitHub.

# Where the SQLite database file lives (created automatically on first run)
DATABASE_PATH=./db/inventory.db

# Change this to a long random string in production
JWT_SECRET=replace-this-with-a-long-random-secret

# Port the API server runs on
PORT=4000

# Comma-separated list of origins allowed to call the API (your website's domain(s))
# Example: CORS_ORIGINS=https://mystore.com,https://www.mystore.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173
